    // ─── animated canvas background ───
    const canvas = document.getElementById('bgCanvas');
    const ctx = canvas.getContext('2d');
    let w, h, particles = [];

    function resizeCanvas() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // draw a subtle dot grid that drifts slowly
    function drawBg(time) {
      ctx.clearRect(0, 0, w, h);
      const spacing = 40;
      const offsetX = (time * 0.02) % spacing;
      const offsetY = (time * 0.015) % spacing;
      ctx.fillStyle = 'rgba(66, 133, 244, 0.12)';
      for (let x = offsetX - spacing; x < w + spacing; x += spacing) {
        for (let y = offsetY - spacing; y < h + spacing; y += spacing) {
          ctx.beginPath();
          ctx.arc(x, y, 1.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      // occasional larger dots
      ctx.fillStyle = 'rgba(52, 168, 83, 0.08)';
      for (let x = offsetX * 0.7; x < w; x += spacing * 2.5) {
        for (let y = offsetY * 0.7; y < h; y += spacing * 2.5) {
          ctx.beginPath();
          ctx.arc(x, y, 2.5, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      requestAnimationFrame(drawBg);
    }
    requestAnimationFrame(drawBg);

    // ─── ripple effect on all buttons ───
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.option-btn, .btn-primary');
      if (!btn) return;
      const rect = btn.getBoundingClientRect();
      const r = document.createElement('span');
      r.className = 'ripple';
      const size = Math.max(rect.width, rect.height);
      r.style.width = r.style.height = size + 'px';
      r.style.left = (e.clientX - rect.left - size / 2) + 'px';
      r.style.top = (e.clientY - rect.top - size / 2) + 'px';
      btn.appendChild(r);
      setTimeout(() => r.remove(), 600);
    });

