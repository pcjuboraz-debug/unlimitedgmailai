    // ─── status bar clock ───
    function updateStatusTime() {
      const d = new Date();
      document.getElementById('statusTime').textContent =
        d.toTimeString().split(' ')[0];
    }
    setInterval(updateStatusTime, 1000);
    updateStatusTime();

    function generate() {
      const now = Date.now();
      if (now - lastGenTime < COOLDOWN) {
        const rem = Math.ceil((COOLDOWN - (now - lastGenTime)) / 1000);
        showToast(langData[currentLang].cooldown_msg.replace("{s}", rem), true);
        return;
      }
      if (clickCount >= 15) {
        showToast(langData[currentLang].limit_msg, true);
        return;
      }
      clickCount++;
      lastGenTime = Date.now();
      document.getElementById("loaderArea").style.display = "block";
      document.getElementById("resultCard").style.display = "none";
      document.getElementById("genBtn").disabled = true;
      let p = 0;
      const intv = setInterval(() => {
        p += 2;
        document.getElementById("progress").style.width = p + "%";
        if (p >= 100) {
          clearInterval(intv);
          document.getElementById("loaderArea").style.display = "none";
          document.getElementById("genBtn").disabled = false;
          showResult();
        }
      }, 100);
    }

