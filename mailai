<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google Premium Account Creator</title>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
    :root {
      --primary-color: #4285F4;
      --success-color: #34A853;
      --warning-color: #FBBC05;
      --danger-color: #EA4335;
      --bg-dark: #070b14;
      --card-bg: rgba(255, 255, 255, 0.04);
      --glass-blur: blur(15px);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: #fff;
      font-family: 'Google Sans', sans-serif;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      width: 100%;
    }

    /* ---- animated background grid ---- */
    #bgCanvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0.3;
    }

    /* Welcome Screen */
    #welcomeScreen {
      position: fixed;
      inset: 0;
      background: #000;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 10000;
      transition: opacity 0.8s ease-out;
    }

    .welcome-brand {
      position: relative;
    }

    .welcome-brand .glitch-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 14px;
      color: var(--primary-color);
      opacity: 0;
      font-family: monospace;
    }

    .loader-circle {
      width: 50px;
      height: 50px;
      border: 4px solid #1a1a1a;
      border-top: 4px solid var(--primary-color);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* Globally Fixed Demo Button */
    .demo-view-btn {
      position: fixed;
      top: 15px;
      right: 20px;
      background: var(--card-bg);
      padding: 10px 18px;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: var(--glass-blur);
      z-index: 10005;
      transition: 0.3s;
      color: #fff;
      display: none;
    }

    .demo-view-btn:hover {
      background: var(--primary-color);
    }

    /* Containers */
    #selectionGate,
    #langSelection {
      position: fixed;
      inset: 0;
      background: rgba(7, 11, 20, 0.85);
      z-index: 9998;
      display: flex;
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(8px);
    }

    .auth-card {
      background: var(--card-bg);
      padding: 30px 20px;
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      text-align: center;
      max-width: 440px;
      width: 92%;
      backdrop-filter: var(--glass-blur);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
      max-height: 90vh;
      overflow-y: auto;
      animation: cardFloat 0.5s ease-out;
    }

    @keyframes cardFloat {
      0% {
        opacity: 0;
        transform: translateY(24px) scale(0.96);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .option-btn {
      width: 100%;
      padding: 16px;
      margin: 10px 0;
      border-radius: 15px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      color: white;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      transition: 0.3s;
      position: relative;
      overflow: hidden;
    }

    .option-btn:hover {
      background: var(--primary-color);
      transform: translateY(-2px);
    }

    /* ripple effect on buttons */
    .ripple {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: scale(0);
      animation: rippleAnim 0.6s ease-out;
      pointer-events: none;
    }

    @keyframes rippleAnim {
      to {
        transform: scale(4);
        opacity: 0;
      }
    }

    .payment-instruction {
      background: rgba(255, 255, 255, 0.03);
      padding: 18px;
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      margin-bottom: 15px;
      text-align: left;
      font-size: 13px;
      line-height: 1.6;
    }

    .payment-instruction h3 {
      font-size: 16px;
      margin-bottom: 12px;
      text-align: center;
      color: var(--warning-color);
    }

    /* Rules Icon */
    @keyframes glow {
      50% {
        box-shadow: 0 0 15px var(--warning-color);
        transform: scale(1.1);
      }
    }

    .glowing-info {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--bg-dark);
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 22px;
      cursor: pointer;
      border: 2px solid var(--primary-color);
      animation: glow 2s infinite ease-in-out;
      z-index: 999;
      display: none;
    }

    /* rules modal overlay */
    #rulesOverlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 10000;
      display: none;
      backdrop-filter: blur(4px);
    }

    #rulesModal {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.9);
      background: #0f172a;
      padding: 25px;
      border-radius: 20px;
      z-index: 10001;
      width: 85%;
      max-width: 400px;
      display: none;
      border: 1px solid rgba(255, 255, 255, 0.1);
      opacity: 0;
      transition: 0.3s;
    }

    #rulesModal.show {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    #rulesModal li {
      margin-bottom: 10px;
      font-size: 13px;
      line-height: 1.4;
      color: #cbd5e1;
      display: flex;
      gap: 10px;
      text-align: left;
    }

    header {
      width: 100%;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(7, 11, 20, 0.8);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
      z-index: 10;
    }

    /* status bar below header */
    #statusBar {
      width: 100%;
      padding: 6px 20px;
      display: flex;
      gap: 18px;
      background: rgba(7, 11, 20, 0.6);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 10px;
      color: #64748b;
      font-family: monospace;
      position: relative;
      z-index: 10;
      display: none;
      flex-wrap: wrap;
    }

    .status-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-dot.green {
      background: var(--success-color);
      box-shadow: 0 0 6px var(--success-color);
    }

    .status-dot.yellow {
      background: var(--warning-color);
      box-shadow: 0 0 6px var(--warning-color);
    }

    .container {
      width: 92%;
      max-width: 600px;
      padding: 30px 0;
      text-align: center;
      position: relative;
      z-index: 10;
    }

    h1 {
      font-size: 28px;
      margin-bottom: 10px;
      background: linear-gradient(to right, #4285F4, #34A853, #FBBC05, #EA4335);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    input {
      width: 100%;
      padding: 15px;
      margin: 10px 0;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #111827;
      color: white;
      text-align: center;
      font-size: 16px;
      transition: border-color 0.3s;
    }

    input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 12px rgba(66, 133, 244, 0.2);
    }

    .account-card {
      background: var(--card-bg);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 25px;
      margin-top: 20px;
      display: none;
      animation: cardFloat 0.4s ease-out;
    }

    .data-row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      background: #111827;
      padding: 15px;
      border-radius: 12px;
      margin-bottom: 10px;
      border-left: 3px solid var(--primary-color);
    }

    .value {
      color: #fff;
      font-weight: bold;
      font-family: monospace;
      font-size: 16px;
      margin-top: 5px;
      word-break: break-all;
    }

    .btn-primary {
      background: var(--primary-color);
      color: white;
      padding: 16px 30px;
      border-radius: 12px;
      border: none;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
      position: relative;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-primary:active {
      transform: scale(0.97);
    }

    /* toast */
    #toast {
      visibility: hidden;
      min-width: 220px;
      background-color: var(--success-color);
      color: #fff;
      text-align: center;
      border-radius: 10px;
      padding: 15px;
      position: fixed;
      z-index: 10002;
      bottom: 80px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 14px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    }

    #toast.show {
      visibility: visible;
      animation: fadein 0.4s, fadeout 0.4s 2.6s;
    }

    #toast.error {
      background-color: var(--danger-color);
    }

    @keyframes fadein {
      from {
        opacity: 0;
        transform: translateX(-50%) translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }

    @keyframes fadeout {
      from {
        opacity: 1;
      }

      to {
        opacity: 0;
      }
    }

    /* glitch text utility */
    .glitch-text {
      display: inline-block;
      font-family: monospace;
    }

    </style>
  </head>

